  "content": "<div id=\"fmlink-root\">\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Playfair+Display:wght@700;800;900&family=Inter:wght@300;400;500;600;700&display=swap');\n  #fmlink-root{\n    --bg:#0a0a0b; --card:#0e0e0f;\n    --gold-a:#f4dfa0; --gold-b:#e6b450; --gold-c:#b8860b;\n    --amber-400:#FBBF24; --amber-500:#F59E0B; --amber-600:#D97706;\n    --ink:#fafafa; --ink-2:#d4d4d8; --ink-3:#a1a1aa;\n    --line:rgba(230,180,80,.20); --line-strong:rgba(230,180,80,.55);\n    --serif:\"Playfair Display\",Georgia,serif;\n    --anton:\"Anton\",var(--sans);\n    --sans:\"Inter\",ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;\n    --maxw:600px;\n    all:initial;\n    display:block; position:relative;\n    background:var(--bg); color:var(--ink); font-family:var(--sans); font-weight:300;\n    line-height:1.5; -webkit-font-smoothing:antialiased; min-height:100vh;\n    padding:0; margin:0;\n  }\n  #fmlink-root *{box-sizing:border-box; font-family:inherit;}\n  #fmlink-root .warm-glow{\n    position:absolute; inset:0; pointer-events:none; z-index:0;\n    background:radial-gradient(60% 55% at 50% 0%,rgba(230,180,80,.20) 0%,rgba(184,134,11,.07) 40%,rgba(10,10,11,0) 72%);\n  }\n  #fmlink-root .wrap{position:relative; z-index:1; max-width:var(--maxw); margin:0 auto; padding:40px 20px 56px;}\n  #fmlink-root .gold{\n    background:linear-gradient(120deg,var(--gold-a) 0%,var(--gold-b) 42%,var(--gold-c) 100%);\n    -webkit-background-clip:text; background-clip:text; color:transparent;\n  }\n\n  /* ---- AUTOR (topo) ---- */\n  #fmlink-root .author{display:flex; flex-direction:column; align-items:center; text-align:center; margin-bottom:34px;}\n  #fmlink-root .author-photo{\n    width:104px; height:104px; border-radius:50%; object-fit:cover; object-position:50% 25%;\n    border:2px solid transparent; background:\n      linear-gradient(#0a0a0b,#0a0a0b) padding-box,\n      linear-gradient(120deg,var(--gold-a),var(--gold-c)) border-box;\n    box-shadow:0 12px 40px -12px rgba(230,180,80,.5);\n  }\n  #fmlink-root .author-name{font-family:var(--anton); font-weight:400; text-transform:uppercase; font-size:clamp(30px,7vw,42px); margin:16px 0 4px; letter-spacing:.5px; line-height:1.02;}\n  #fmlink-root .author-verified{display:inline-block; vertical-align:middle; width:20px; height:20px; margin-left:6px;}\n  #fmlink-root .author-role{font-size:11px; font-weight:700; letter-spacing:.28em; text-transform:uppercase; color:var(--amber-400); margin-bottom:14px;}\n  #fmlink-root .author-bio{color:var(--ink-2); font-size:14.5px; max-width:46ch; margin:0 auto;}\n  #fmlink-root .author-bio strong{color:var(--ink); font-weight:600;}\n  #fmlink-root .author-handle{margin-top:12px; font-size:13px; color:var(--ink-3); font-weight:500;}\n\n  /* ---- LINKS ---- */\n  #fmlink-root .section-eyebrow{font-size:10.5px; font-weight:700; letter-spacing:.3em; text-transform:uppercase; color:var(--amber-400); text-align:center; margin:0 0 16px;}\n  #fmlink-root .links{display:flex; flex-direction:column; gap:12px;}\n  #fmlink-root a.link-card{\n    display:flex; align-items:center; gap:14px; text-decoration:none; cursor:pointer;\n    background:var(--card); border:1px solid var(--line); border-radius:15px;\n    padding:16px 18px; color:var(--ink);\n    transition:transform .18s, border-color .18s, box-shadow .18s, background .18s;\n  }\n  #fmlink-root a.link-card:hover{transform:translateY(-2px); border-color:var(--line-strong); box-shadow:0 18px 44px -22px rgba(230,180,80,.45);}\n  #fmlink-root .link-emoji{\n    flex:none; width:44px; height:44px; display:grid; place-items:center; font-size:21px;\n    border-radius:12px; background:radial-gradient(120% 120% at 30% 20%,#15130c,#0a0a0b);\n    border:1px solid var(--line);\n  }\n  #fmlink-root .link-tx{flex:1; min-width:0;}\n  #fmlink-root .link-title{font-weight:600; font-size:15.5px; line-height:1.25;}\n  #fmlink-root .link-desc{font-size:12.5px; color:var(--ink-3); margin-top:2px;}\n  #fmlink-root .link-arrow{flex:none; color:var(--ink-3); font-size:18px; transition:transform .18s, color .18s;}\n  #fmlink-root a.link-card:hover .link-arrow{color:var(--amber-400); transform:translateX(3px);}\n\n  #fmlink-root .hair{height:1px; background:linear-gradient(90deg,rgba(230,180,80,0),rgba(230,180,80,.6),rgba(230,180,80,0)); margin:40px 0;}\n\n  /* ---- PROVA ---- */\n  #fmlink-root .prova-title{font-family:var(--serif); font-weight:700; font-size:clamp(22px,5vw,28px); text-align:center; margin:0 0 6px;}\n  #fmlink-root .prova-sub{text-align:center; color:var(--ink-3); font-size:13.5px; margin:0 0 22px;}\n  #fmlink-root .prova-grid{display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px;}\n  #fmlink-root .prova-grid img{width:100%; aspect-ratio:3/4; object-fit:cover; border-radius:12px; border:1px solid var(--line);}\n  #fmlink-root .prova-foot{text-align:center; color:var(--ink-3); font-size:12.5px; margin-top:16px;}\n  #fmlink-root .prova-foot strong{color:var(--amber-400); font-weight:600;}\n\n  /* ---- CTA CONSULTORIA ---- */\n  #fmlink-root .cta{\n    margin-top:40px; background:linear-gradient(180deg,rgba(251,191,36,.10),rgba(251,191,36,.02));\n    border:1px solid var(--line-strong); border-radius:20px; padding:30px 24px; text-align:center;\n  }\n  #fmlink-root .cta-eyebrow{font-size:10.5px; font-weight:700; letter-spacing:.3em; text-transform:uppercase; color:var(--amber-400); margin:0 0 10px;}\n  #fmlink-root .cta-title{font-family:var(--serif); font-weight:800; font-size:clamp(22px,5.5vw,30px); margin:0 0 12px; line-height:1.15;}\n  #fmlink-root .cta-text{color:var(--ink-2); font-size:14.5px; max-width:44ch; margin:0 auto 22px;}\n  #fmlink-root .cta-btn{\n    display:inline-flex; align-items:center; gap:9px; text-decoration:none;\n    background:linear-gradient(90deg,var(--amber-400),var(--amber-500) 50%,var(--amber-600));\n    color:#0a0a0b; font-weight:700; font-size:16px; padding:16px 34px; border-radius:13px;\n    transition:filter .18s, transform .18s;\n  }\n  #fmlink-root .cta-btn:hover{filter:brightness(1.08); transform:translateY(-1px);}\n  #fmlink-root .foot-note{text-align:center; color:#71717a; font-size:11px; margin-top:26px;}\n\n  /* ---- PAINEL ADMIN (só com #admin) ---- */\n  #fmlink-admin{display:none; position:relative; z-index:2; max-width:var(--maxw); margin:0 auto 10px; padding:20px; background:#141414; border:1px solid var(--line-strong); border-radius:16px;}\n  #fmlink-root.admin-on #fmlink-admin{display:block;}\n  #fmlink-admin h3{font-family:var(--serif); font-size:19px; margin:0 0 4px; color:var(--ink);}\n  #fmlink-admin .hint{color:var(--ink-3); font-size:12.5px; margin:0 0 16px;}\n  #fmlink-admin .row{display:flex; gap:8px; align-items:center; background:#0e0e0f; border:1px solid var(--line); border-radius:10px; padding:8px 10px; margin-bottom:8px;}\n  #fmlink-admin .row .grab{cursor:grab; color:var(--ink-3); font-size:16px; user-select:none;}\n  #fmlink-admin .row input{flex:1; min-width:0; background:transparent; border:none; color:var(--ink); font-size:13.5px; padding:6px 4px;}\n  #fmlink-admin .row input:focus{outline:none;}\n  #fmlink-admin .row .emoji-in{flex:none; width:44px; text-align:center;}\n  #fmlink-admin .row .del{cursor:pointer; color:#ef6a6a; background:none; border:none; font-size:16px; flex:none;}\n  #fmlink-admin .sep{height:1px; background:var(--line); margin:6px 0;}\n  #fmlink-admin .btns{display:flex; gap:10px; margin-top:14px; flex-wrap:wrap;}\n  #fmlink-admin button.act{cursor:pointer; border:1px solid var(--line-strong); background:#0e0e0f; color:var(--ink); font-weight:600; font-size:13px; padding:11px 16px; border-radius:10px; transition:.15s;}\n  #fmlink-admin button.act:hover{border-color:var(--amber-400);}\n  #fmlink-admin button.gold{background:linear-gradient(90deg,var(--amber-400),var(--amber-600)); color:#0a0a0b; border:none;}\n  #fmlink-admin .ok{color:#4ade80; font-size:12.5px; margin-top:10px; min-height:16px;}\n\n  @media (max-width:420px){ #fmlink-root .prova-grid{grid-template-columns:1fr 1fr;} }\n\n  /* BLINDAGEM contra o tema do WordPress (que força cor em h1/h2/h3/p/a).\n     Sem isso, textos que herdavam a cor apareciam pretos no fundo escuro. */\n  #fmlink-root .author-name, #fmlink-root .cta-title, #fmlink-root .prova-title{ color:var(--ink) !important; }\n  #fmlink-root a.link-card, #fmlink-root .link-title{ color:var(--ink) !important; }\n  #fmlink-root .cta-text, #fmlink-root .author-bio{ color:var(--ink-2) !important; }\n  #fmlink-root .prova-sub, #fmlink-root .link-desc, #fmlink-root .author-handle, #fmlink-root .foot-note{ color:var(--ink-3) !important; }\n  #fmlink-root .cta-eyebrow, #fmlink-root .section-eyebrow, #fmlink-root .author-role{ color:var(--amber-400) !important; }\n  #fmlink-root .cta-btn{ color:#0a0a0b !important; }\n  #fmlink-root .link-arrow{ color:var(--ink-3) !important; }\n  #fmlink-root a.link-card:hover .link-arrow{ color:var(--amber-400) !important; }\n  /* texto dourado (gradiente) — garante que não vire preto */\n  #fmlink-root .gold{ color:transparent !important; -webkit-text-fill-color:transparent !important; }\n</style>\n\n<div class=\"warm-glow\"></div>\n\n\n<script id=\"fmlink-data\" type=\"application/json\">\n[\n  {\"emoji\":\"🔥\",\"title\":\"A dieta que seca sem passar fome\",\"desc\":\"O guia completo do método\",\"url\":\"https://fabriciomoura.com/dieta-que-seca-sem-fome\"},\n  {\"emoji\":\"🧮\",\"title\":\"Calculadora de IMC e calorias\",\"desc\":\"Descubra seu gasto e sua meta\",\"url\":\"https://fabriciomoura.com/calculadora-de-imc-e-calorias\"},\n  {\"emoji\":\"🍽️\",\"title\":\"Déficit calórico: como fazer certo\",\"desc\":\"Emagrecer sem se matar de fome\",\"url\":\"https://fabriciomoura.com/deficit-calorico\"},\n  {\"emoji\":\"🥦\",\"title\":\"Alimentos ricos em fibras\",\"desc\":\"O que segura a fome de verdade\",\"url\":\"https://fabriciomoura.com/alimentos-ricos-em-fibras\"},\n  {\"emoji\":\"⚠️\",\"title\":\"Gordura visceral: o perigo escondido\",\"desc\":\"Por que a barriga não sai\",\"url\":\"https://fabriciomoura.com/gordura-visceral\"},\n  {\"emoji\":\"🍚\",\"title\":\"Arroz engorda?\",\"desc\":\"A verdade sobre o carboidrato\",\"url\":\"https://fabriciomoura.com/arroz-engorda\"},\n  {\"emoji\":\"💪\",\"title\":\"Creatina: engorda ou emagrece?\",\"desc\":\"O que ela faz de verdade\",\"url\":\"https://fabriciomoura.com/creatina-engorda-ou-emagrece\"}\n]\n</script>\n\n\n<div class=\"wrap\">\n\n  \n  <div class=\"author\">\n    <img decoding=\"async\" class=\"author-photo\" src=\"/paginas/2482862983a7.png\" alt=\"Fabricio Moura\">\n    <div class=\"author-name\"><span class=\"gold\">Fabricio Moura</span><svg class=\"author-verified\" viewBox=\"0 0 24 24\" fill=\"#1D9BF0\"><path d=\"M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81c-.66-1.31-1.91-2.19-3.34-2.19s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81s-1.26 2.52-.8 3.91c-1.31.67-2.2 1.91-2.2 3.34s.89 2.67 2.2 3.34c-.46 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34zm-11.71 4.2L6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z\"/></svg></div>\n    <div class=\"author-role\">Nutricionista e Treinador</div>\n    <p class=\"author-bio\">Mais de <strong>2.000 transformações</strong> em <strong>7 países</strong> e <strong>18 anos</strong> de experiência ajudando pessoas a perder gordura e ganhar massa muscular com um método garantido.</p>\n    <div class=\"author-handle\">@fabriciomourateam</div>\n  </div>\n\n  \n  <p class=\"section-eyebrow\">Conteúdos que vão te ajudar</p>\n  <div class=\"links\" id=\"fmlink-list\"></div>\n\n  <div class=\"hair\"></div>\n\n  \n  <h2 class=\"prova-title\">Prova <span class=\"gold\">real</span></h2>\n  <p class=\"prova-sub\">Transformações de quem fez o acompanhamento</p>\n  <div class=\"prova-grid\">\n    <img decoding=\"async\" src=\"https://fabriciomoura.com/wp-content/uploads/2024/10/4-1.png\" alt=\"Transformação de aluno do Fabricio Moura\">\n    <img decoding=\"async\" src=\"https://fabriciomoura.com/wp-content/uploads/2024/10/5-1.png\" alt=\"Transformação de aluno do Fabricio Moura\">\n    <img decoding=\"async\" src=\"https://fabriciomoura.com/wp-content/uploads/2024/10/6-1.png\" alt=\"Transformação de aluno do Fabricio Moura\">\n  </div>\n  <p class=\"prova-foot\">Mais de <strong>2.000 transformações reais</strong> em 7 países.</p>\n\n  \n  <div class=\"cta\">\n    <p class=\"cta-eyebrow\">Consultoria Premium com Fabricio Moura</p>\n    <h2 class=\"cta-title\">Quer um plano que <span class=\"gold\">realmente funciona</span>?</h2>\n    <p class=\"cta-text\">Eu monto a sua estratégia de nutrição e treino personalizada para você perder gordura e ganhar músculo, com acompanhamento de perto e garantia de resultados.</p>\n    <a class=\"cta-btn\" href=\"https://wa.me/+5511914849797?text=Oi%20Fabricio!%20Vim%20pela%20p%C3%A1gina%20de%20links%20e%20quero%20saber%20da%20consultoria.\" target=\"_blank\" rel=\"noopener\">Falar com o Fabricio &nbsp;→</a>\n  </div>\n\n  <p class=\"foot-note\">© Fabricio Moura · Nutricionista e Treinador</p>\n</div>\n\n<script>\n(function(){\n  // ==================================================================\n  //  COLE AQUI O LINK CSV DA SUA PLANILHA GOOGLE (entre as aspas).\n  //  Como pegar: na planilha > Arquivo > Compartilhar > Publicar na web\n  //  > escolha \"Valores separados por vírgula (.csv)\" > Publicar > copie o link.\n  //  Deixe \"\" (vazio) pra usar a lista padrao embutida.\n  var SHEET_CSV_URL = \"https://docs.google.com/spreadsheets/d/e/2PACX-1vREoYXkg3XEk0wwVT-bPnfVS1NsyeY2Jjhy5rKRtNzzluWORHCyrHkhubmNUpmgoA9oJe6IDv6usT89/pub?output=csv\";\n  // ==================================================================\n\n  var dataTag = document.getElementById('fmlink-data');\n  var list = document.getElementById('fmlink-list');\n  function defaults(){ try { return JSON.parse(dataTag.textContent) || []; } catch(e){ return []; } }\n  function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;'); }\n\n  function render(links){\n    if(!links || !links.length) links = defaults();\n    list.innerHTML = links.map(function(l){\n      if(!l.title || !l.url) return '';\n      var url = /^https?:\\/\\//i.test(l.url) ? l.url : 'https://'+l.url;\n      var desc = l.desc ? '<div class=\"link-desc\">'+esc(l.desc)+'</div>' : '';\n      var emoji = l.emoji ? '<span class=\"link-emoji\">'+esc(l.emoji)+'</span>' : '';\n      return '<a class=\"link-card\" href=\"'+esc(url)+'\" target=\"_blank\" rel=\"noopener\">'+emoji+\n             '<span class=\"link-tx\"><span class=\"link-title\">'+esc(l.title)+'</span>'+desc+'</span>'+\n             '<span class=\"link-arrow\">\\u2192</span></a>';\n    }).join('');\n  }\n\n  // CSV parser (aguenta virgula dentro de aspas)\n  function parseCSV(text){\n    var rows=[], row=[], cur='', q=false, c; text=text.replace(/\\r/g,'');\n    for(var i=0;i<text.length;i++){ c=text[i];\n      if(q){ if(c=='\"'){ if(text[i+1]=='\"'){cur+='\"';i++;} else q=false; } else cur+=c; }\n      else { if(c=='\"') q=true; else if(c==',') { row.push(cur); cur=''; }\n        else if(c=='\\n'){ row.push(cur); rows.push(row); row=[]; cur=''; } else cur+=c; }\n    }\n    if(cur.length||row.length){ row.push(cur); rows.push(row); }\n    return rows;\n  }\n  function norm(s){ return String(s||'').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').trim(); }\n  function rowsToLinks(rows){\n    if(!rows.length) return [];\n    var head = rows[0].map(norm);\n    function idx(names){ for(var j=0;j<head.length;j++){ for(var k=0;k<names.length;k++){ if(head[j].indexOf(names[k])!==-1) return j; } } return -1; }\n    var iE=idx(['emoji','icone']), iT=idx(['titulo','title','nome']), iD=idx(['desc']), iU=idx(['link','url','endereco']);\n    var out=[];\n    for(var r=1;r<rows.length;r++){ var c=rows[r]||[];\n      var o={ emoji:iE>=0?(c[iE]||'').trim():'', title:iT>=0?(c[iT]||'').trim():'', desc:iD>=0?(c[iD]||'').trim():'', url:iU>=0?(c[iU]||'').trim():'' };\n      if(o.title || o.url) out.push(o);\n    }\n    return out;\n  }\n\n  if(SHEET_CSV_URL){\n    render(defaults()); // mostra a lista padrao enquanto a planilha carrega\n    fetch(SHEET_CSV_URL, {cache:'no-store'})\n      .then(function(r){ return r.text(); })\n      .then(function(t){ var l=rowsToLinks(parseCSV(t)); render(l.length?l:defaults()); })\n      .catch(function(){ render(defaults()); });\n  } else {\n    render(defaults());\n  }\n})();\n</script>\n</div>"
}
