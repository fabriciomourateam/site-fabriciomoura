  "content": "<p><!--noptimize--></p>\n<style>\n  body.single-post #masthead,\n  body.single-post .ast-above-header-wrap,\n  body.single-post .ast-below-header-wrap,\n  body.single-post .site-footer{display:none !important}\n</style>\n<p><!--/noptimize--></p>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Montserrat:wght@400;500;600;700;800;900&display=swap');\n  .mj{\n    --gold1:#FFE9A8;--gold2:#FCD404;--gold3:#C9920A;--y:#FCD404;\n    --blk:#0e0e0e;--line:rgba(255,255,255,.08);--tx:#e9e9e9;--mut:#a8a8a8;\n    --mont:'Montserrat',sans-serif;--anton:'Anton',sans-serif;\n  }\n  .mj,.mj *{box-sizing:border-box;margin:0;padding:0}\n  .mj{background:var(--blk);color:var(--tx);font-family:var(--mont);line-height:1.78;position:relative;overflow:hidden}\n  .mj .wrap{max-width:720px;margin:0 auto;padding:0 22px;position:relative;z-index:2}\n  .gold{background:linear-gradient(135deg,var(--gold1),var(--gold2) 45%,var(--gold3));-webkit-background-clip:text;background-clip:text;color:transparent}</p>\n<p>  .mj-hero{position:relative;text-align:center;padding:120px 0 48px;border-bottom:1px solid var(--line);overflow:hidden}\n  .mj-hero::before{content:'';position:absolute;top:-220px;left:50%;transform:translateX(-50%);width:760px;height:520px;\n    background:radial-gradient(circle, rgba(252,212,4,.14), transparent 62%);pointer-events:none}\n  .mj-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(252,212,4,.1);border:1px solid rgba(252,212,4,.35);\n    color:var(--gold2);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;padding:8px 16px;border-radius:100px;margin-bottom:22px}\n  .mj-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold2);box-shadow:0 0 10px var(--gold2)}\n  .mj-hero h1{font-family:var(--anton);font-weight:400;text-transform:uppercase;color:#fff;font-size:2.7rem;line-height:1.06;letter-spacing:.5px}\n  .mj-hero .sub{color:#cfcfcf;font-size:1.12rem;margin