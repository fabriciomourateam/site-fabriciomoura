ext-transform:uppercase;padding:8px 16px;border-radius:100px;margin-bottom:22px}\n  .mj-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold2);box-shadow:0 0 10px var(--gold2)}\n  .mj-hero h1{font-family:var(--anton);font-weight:400;text-transform:uppercase;color:#fff;font-size:2.7rem;line-height:1.06;letter-spacing:.5px}\n  .mj-hero .sub{color:#cfcfcf;font-size:1.12rem;margin:18px auto 0;max-width:560px}\n  .mj-meta{display:flex;align-items:center;justify-content:center;gap:14px;margin-top:22px;color:var(--mut);font-size:.82rem;text-transform:uppercase;letter-spacing:.08em}\n  .mj-meta span{display:inline-flex;align-items:center;gap:7px}\n  .mj-meta i{width:5px;height:5px;border-radius:50%;background:var(--gold2);display:inline-block}</p>\n<p>  /* ARTICLE */\n  .mj article{padding:44px 0 10px}\n  .mj p{font-size:1.1rem;margin-bottom:18px;color:#dcdcdc}\n  .mj p b,.mj p strong{color:#fff}\n  .mj h2{font-family:var(--mont);font-weight:800;color:#fff;font-size:1.55rem;line-height:1.25;margin:46px 0 18px;letter-spacing:-.2px}\n  .mj h2 .kick{display:block;font-size:.72rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;margin-bottom:10px}\n  .mj h3{font-weight:800;font-size:1.18rem;color:#fff;margin:26px 0 6px}</p>\n<p>  .mj-quote{border-left:3px solid var(--gold2);padding:6px 0 6px 22px;margin:30px 0;font-family:var(--mont);font-weight:700;\n    font-size:1.32rem;line-height:1.4;color:#fff}\n  .mj-quote b{color:var(--gold2)}</p>\n<p>  /* LISTA DE ALIMENTOS */\n  .mj-foods{display:grid;gap:14px;margin:26px 0}\n  .mj-food{display:flex;gap:16px;align-items:flex-start;background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.012));\n    border:1px solid var(--line);border-radius:16px;padding:18px 20px}\n  .mj-food .em{font-size:30px;line-height:1;flex-shrink:0;width:46px;height:46px;border-radius:12px;background:rgba(252,212,4,.1);display:flex;align-items:center;justify-content:center}\n  .mj-food h3{margin:0