:28px 0;font-size:.96rem;color:#ecdcb4}\n  .mj-note .x{font-size:20px;line-height:1.2}</p>\n<p>  .mj-avoid{list-style:none;margin:8px 0 18px;display:grid;gap:10px}\n  .mj-avoid li{display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,.025);border:1px solid var(--line);border-radius:13px;padding:14px 16px;font-size:1.02rem;color:#dcdcdc}\n  .mj-avoid li::before{content:'\\2715';color:#ff6b6b;font-weight:900;font-size:.95rem;margin-top:2px}</p>\n<p>  .mj-faq{margin-top:10px}\n  .mj-faq details{background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.01));border:1px solid var(--line);border-radius:14px;margin-bottom:12px;overflow:hidden;transition:.25s}\n  .mj-faq details[open]{border-color:rgba(252,212,4,.4)}\n  .mj-faq summary{padding:18px 20px;cursor:pointer;font-weight:700;font-size:1.04rem;color:#fff;list-style:none;display:flex;justify-content:space-between;gap:14px;align-items:center}\n  .mj-faq summary::-webkit-details-marker{display:none}\n  .mj-faq summary::after{content:'+';color:var(--gold2);font-weight:800;font-size:1.4rem;line-height:1}\n  .mj-faq details[open] summary::after{content:'\\2013'}\n  .mj-faq .a{padding:0 20px 18px;color:#c8c8c8;font-size:1rem}</p>\n<p>  .mj-cta{position:relative;display:flex;align-items:center;gap:28px;margin:48px 0;padding:36px 32px;border-radius:24px;overflow:hidden;\n    background:linear-gradient(160deg,rgba(252,212,4,.12),rgba(252,212,4,.02));border:1px solid rgba(252,212,4,.4)}\n  .mj-cta::before{content:'';position:absolute;top:-120px;left:50%;transform:translateX(-50%);width:480px;height:340px;background:radial-gradient(circle,rgba(252,212,4,.22),transparent 65%);pointer-events:none}\n  .mj-cta>*{position:relative;z-index:2}\n  .mj-cta-text{flex:1}\n  .mj-cta-img{width:190px;flex-shrink:0;border-radius:16px;border:1px solid var(--line);display:block}\n  .mj-cta h2{font-family:var(--anton);font-weight:400;text-transform:uppercase;font-size:2rem;margin:0 0 12px;line-height:1.08}\n  .mj-cta p{margin:0 0 22px;color:#eaeaea}\n  .mj-btn{display:inline-flex;align-items:center;gap:11px;background:linear-gradient(135deg,var(--gold1),var(--gold2) 50%,var(--gold3));color:#1a1300;\n    font-weight:800;text-transform:uppercase;letter-spacing:.03em;font-size:1.02rem;padding:17px 34px;border-radius:14px;text-decoration:none;\n    box-shadow:0 16px 40px -12px rgba(252,212,4,.6);transition:.25s}\n  .mj-btn:hover{transform:translateY(-2px)}\n  .mj-btn svg{width:21px;height:21px;fill:#1a1300}</p>\n<p>  .mj p a,.mj-faq .a a{color:var(--gold2);text-decoration:underline;text-underline-offset:3px;font-weight:600}\n  .mj-lead{font-size:1.25rem !important;color:#fff !important;font-weight:600;line-height:1.55}\n  .mj-author-btn{display:inline-flex;align-items:center;gap:9px;margin-top:14px;background:linear-gradient(135deg,var(--gold1),var(--gold2) 50%,var(--gold3));color:#1a1300;font-weight:800;text-transform:uppercase;font-size:.82rem;letter-spacing:.03em;padding:12px 22px;border-radius:11px;text-decoration:none;position:relative;z-index:2}\n  .mj-author-btn svg{width:18px;height:18px;fill:#1a1300}\n  .mj-proof{margin:42px 0}\n  .mj-proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:6px;align-items:start}\n  .mj-proof-grid img{width:100%;height:100%;object-fit:cover;border-radius:14px;border:1px solid var(--line);aspect-ratio:3/4;background:#1a1a1a}\n  .mj-proof-cap{text-align:center;color:var(--mut);font-size:.86rem;margin-top:14px;letter-spacing:.02em}\n  .mj-author{display:flex;gap:18px;align-items:center;background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.012));border:1px solid var(--line);border-radius:18px;padding:20px 22px;margin:40px 0 10px}\n  .mj-author img{width:82px;height:82px;border-radius:50%;object-fit:cover;object-position:50% 28%;border:2px solid var(--gold2);flex-shrink:0;background:#1a1a1a}\n  .mj-author .nm{font-family:var(--anton);font-weight:400;text-transform:uppercase;color:#fff;font-size:1.3rem;letter-spacing:.5px;line-height:1}\n  .mj-author .rl{color:var(--mut);font-size:.9rem;margin-top:7px;line-height:1.45}\n  .mj-author .rl b{color:var(--gold2)}\n  .mj-author-top{margin:0 0 32px;align-items:flex-start}\n  .mj-byline{color:var(--mut);font-size:.8rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:9px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n  .mj-byline b{color:#fff}\n  .mj-byline i{width:5px;height:5px;border-radius:50%;background:var(--gold2);display:inline-block}\n  .mj-role{font-weight:800;color:#fff;font-size:1.05rem;margin-bottom:7px}\n  .mj-logo{height:54px;width:auto;margin:0 auto 20px;display:block;mix-blend-mode:screen}\n  .mj-cover{width:100%;height:auto;border-radius:20px;border:1px solid var(--line);margin-top:30px;display:block;box-shadow:0 30px 70px -34px rgba(0,0,0,.9)}\n  .mj-midcta{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;background:linear-gradient(135deg,rgba(252,212,4,.1),rgba(252,212,4,.02));border:1px solid rgba(252,212,4,.32);border-radius:16px;padding:18px 22px;margin:34px 0}\n  .mj-midcta span{font-weight:700;color:#fff;font-size:1.02rem}\n  .mj-midcta a{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--gold1),var(--gold2) 50%,var(--gold3));color:#1a1300;font-weight:800;text-transform:uppercase;font-size:.86rem;letter-spacing:.03em;padding:13px 22px;border-radius:11px;text-decoration:none;white-space:nowrap}\n  .mj-disc{font-size:.82rem;color:#7a7a7a;border-top:1px solid var(--line);padding:22px 0 48px;line-height:1.65}\n  @media(max-width:600px){.mj-hero h1{font-size:1.85rem}.mj h2{font-size:1.3rem}.mj-quote{font-size:1.12rem}.mj-meal{grid-template-columns:1fr;gap:3px}.mj-cta h2{font-size:1.5rem}.mj-cta{flex-direction:column;text-align:center}.mj-cta-img{width:170px;margin:14px auto 0}.mj-author{gap:13px;padding:17px 16px;text-align:left}.mj-author img{width:62px;height:62px}.mj-author .nm{font-size:1.15rem}.mj-proof-grid{grid-template-columns:1fr;max-width:340px;margin-left:auto;margin-right:auto}}\n</style>\n<div class=\"mj\">\n<header class=\"mj-hero\">\n<div class=\"wrap\">\n      <span class=\"mj-badge\">Nutrição &#038; Emagrecimento</span></p>\n<h1>Cardápio para quem toma <span class=\"gold\">Mounjaro</span>: o que comer (e o que evitar)</h1>\n<p class=\"sub\">Como aproveitar o Mounjaro sem perder massa muscular, com energia e resultado de verdade.</p>\n</p></div>\n</header>\n<div class=\"wrap\">\n<article>\n<div class=\"mj-author mj-author-top\">\n        <img decoding=\"async\" src=\"https://fabriciomoura.com/wp-content/uploads/2026/06/Screenshot_20260322_192920_Canva1-scaled.jpg\" alt=\"Fabricio Moura\" loading=\"lazy\" style=\"object-position:50% 50%\" /></p>\n<div>\n<div class=\"mj-byline\">Por <b>Fabricio Moura</b><i></i>Leitura de 6 min</div>\n<div class=\"mj-role\">Nutricionista e Treinador</div>\n<div class=\"rl\"><b>Mais de 2.000 transformações em 7 países</b> e 18 anos de experiência ajudando pessoas a perder gordura e ganhar massa muscular com um método garantido.</div>\n<p>          <a class=\"mj-author-btn\" href=\"https://wa.me/+5511914849797?text=Oi%20Fabricio!%20Quero%20um%20acompanhamento%20individual%20com%20voc%C3%AA.\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\"><path d=\"M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.866 9.866 0 001.51 5.26l-.999 3.648 3.978-1.607z\"/></svg>Falar com o Fabricio</a>\n        </div>\n</p></div>\n<p class=\"mj-lead\">Se olhar no espelho daqui a alguns meses e finalmente gostar do que vê, mais seco e mais forte, é o que todo mundo que começa o Mounjaro quer. A medicação ajuda. Quem decide o resultado é o que você coloca no prato.</p>\n<p>O Mounjaro (tirzepatida) reduz bastante o apetite, e é justamente aí que mora o risco. Comendo pouco, fica fácil perder músculo junto com a gordura, ficar sem energia e abrir buracos de nutrientes no seu dia. A medicação segura o apetite. A <strong>alimentação certa</strong> é o que garante que você perca gordura mantendo saúde e massa magra.</p>\n<p>Abaixo você vê os princípios da alimentação, um <strong>cardápio de exemplo para um dia</strong>, a dieta com o que pode e o que não pode comer, algumas <strong>receitas simples</strong> e os erros que mais sabotam quem está nesse protocolo.</p>\n<div class=\"mj-quote\">A medicação faz você comer menos. A estratégia faz você comer <b>certo</b>. A diferença entre as duas é o seu resultado daqui a seis meses.</div>\n<h2><span class=\"kick gold\">Os fundamentos</span>Os 4 princípios da alimentação no Mounjaro</h2>\n<h3>1. Proteína sempre primeiro</h3>\n<p>Se você vai comer menos, cada refeição precisa render. Comece sempre pela proteína (ovos, carnes magras, frango, peixe, iogurte). Ela preserva o músculo e segura a fome por mais tempo. Uma boa meta é mirar entre <strong>1,6g e 2,2g de proteína por quilo de peso</strong> ao longo do dia.</p>\n<h3>2. Refeições menores e mais frequentes</h3>\n<p>Com o apetite reduzido, pratos enormes incomodam. Prefira porções menores ao longo do dia para bater o que seu corpo precisa sem enjoo.</p>\n<h3>3. Água e fibras todos os dias</h3>\n<p>Beba água ao longo do dia e inclua vegetais e fibras. Isso ajuda na digestão e reduz a constipação, que é comum no começo.</p>\n<h3>4. Menos gordura pesada e açúcar</h3>\n<p>Fritura, excesso de gordura e doce costumam piorar náusea e desconforto. A ideia não é proibir nada, é jogar a seu favor para você passar bem.</p>\n<div class=\"mj-plan\">\n<div class=\"ph\">\n<div class=\"ic\">🍽️</div>\n<h3>Cardápio de exemplo para um dia</h3>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Café da manhã</div>\n<div class=\"d\">Ovos mexidos, uma fatia de pão integral e uma fruta. Café sem açúcar.</div>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Lanche da manhã</div>\n<div class=\"d\">Iogurte natural com boa dose de proteína e poucas castanhas.</div>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Almoço</div>\n<div class=\"d\">Frango ou peixe grelhado, arroz ou batata em porção moderada e bastante salada e legumes.</div>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Lanche da tarde</div>\n<div class=\"d\">Uma fruta com uma fonte de proteína (queijo magro, iogurte ou whey).</div>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Jantar</div>\n<div class=\"d\">Carne magra com legumes refogados. Leve e fácil de digerir.</div>\n</div></div>\n<div class=\"mj-note\">\n<div class=\"x\">⚠️</div>\n<div>Este é um <b>exemplo genérico</b> para ilustrar. As quantidades certas dependem do seu peso, do seu treino e da sua meta. É isso que um acompanhamento individual define.</div>\n</div>\n<div class=\"mj-midcta\"><span>Quer saber quantas calorias comer por dia?</span><a href=\"https://fabriciomoura.com/calculadora-de-imc-e-calorias\" target=\"_blank\" rel=\"noopener\">Calcular agora</a></div>\n<h2><span class=\"kick gold\">A dieta</span>Dieta para quem toma Mounjaro: o que pode e o que não pode</h2>\n<p>Não existe alimento proibido só por causa do Mounjaro. O que muda é a prioridade: como você vai comer menos, o prato precisa ser mais nutritivo e mais fácil de digerir. Um jeito simples de organizar a dieta:</p>\n<div class=\"mj-plan\">\n<div class=\"ph\">\n<div class=\"ic\">✅</div>\n<h3>Pode à vontade (a base do prato)</h3>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Proteínas magras</div>\n<div class=\"d\">Ovos, frango, peixe, carne magra, iogurte natural, whey. Sempre em primeiro lugar.</div>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Vegetais e folhas</div>\n<div class=\"d\">Saladas, legumes cozidos e fibras. Ajudam na digestão e na saciedade.</div>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Frutas</div>\n<div class=\"d\">De preferência com casca ou fibra, junto de uma fonte de proteína.</div>\n</div></div>\n<div class=\"mj-plan\">\n<div class=\"ph\">\n<div class=\"ic\">⚖️</div>\n<h3>Com moderação</h3>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Carboidratos</div>\n<div class=\"d\">Arroz, batata, pão integral e aipim em porção moderada. Não precisa cortar de vez.</div>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Gorduras boas</div>\n<div class=\"d\">Azeite, castanhas e abacate. São boas, mas pesam na digestão no começo do tratamento.</div>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Café</div>\n<div class=\"d\">Sem açúcar, sem problema. Só cuide da hidratação ao longo do dia.</div>\n</div></div>\n<h2><span class=\"kick gold\">Saia da frente</span>O que não pode (ou é melhor evitar)</h2>\n<ul class=\"mj-avoid\">\n<li>Fritura e excesso de gordura, que pioram a náusea</li>\n<li>Doces e bebidas açucaradas</li>\n<li>Refeições gigantes de uma vez só</li>\n<li>Álcool em excesso, que atrapalha o resultado e a hidratação (veja <a href=\"https://fabriciomoura.com/quem-toma-mounjaro-pode-beber/\" target=\"_blank\" rel=\"noopener\">o que acontece ao beber tomando Mounjaro</a>)</li>\n<li>Ficar muitas horas sem comer proteína</li>\n</ul>\n<h2><span class=\"kick gold\">Na prática</span>3 receitas simples para quem toma Mounjaro</h2>\n<div class=\"mj-plan\">\n<div class=\"ph\">\n<div class=\"ic\">🍳</div>\n<h3>Rápidas e ricas em proteína</h3>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Omelete de forno</div>\n<div class=\"d\">3 ovos, espinafre, tomate e queijo magro. Bata, coloque numa forma e leve ao forno. Rende dois cafés da manhã.</div>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Frango desfiado com legumes</div>\n<div class=\"d\">Peito de frango cozido e desfiado, refogado com cenoura, abobrinha e temperos. Porção pequena, muita proteína.</div>\n</div>\n<div class=\"mj-meal\">\n<div class=\"w\">Iogurte proteico</div>\n<div class=\"d\">Iogurte natural com uma dose de whey, canela e poucas castanhas. Um lanche de 30 segundos que segura a fome.</div>\n</div></div>\n<div class=\"mj-note\">\n<div class=\"x\">⚠️</div>\n<div>As porções e as receitas certas dependem do seu peso, do seu treino e da sua meta. Um <a href=\"https://fabriciomoura.com/nutricionista-online/\" target=\"_blank\" rel=\"noopener\">acompanhamento nutricional online</a> monta o cardápio sob medida pro seu caso.</div>\n</div>\n<h2><span class=\"kick gold\">O erro mais comum</span>O erro que sabota quase todo mundo</h2>\n<p>Achar que, &#8220;como estou comendo pouco, qualquer coisa serve&#8221;. Comer pouco <strong>e mal</strong> faz você perder músculo, desacelerar o metabolismo e recuperar o peso assim que parar a medicação. O Mounjaro é uma ferramenta poderosa. Quem constrói o resultado que dura é a estratégia de nutrição e treino por trás dele, e é exatamente isso que um <a href=\"https://fabriciomoura.com/nutricionista-esportivo/\" target=\"_blank\" rel=\"noopener\">nutricionista esportivo</a> monta para você.</p>\n<h2><span class=\"kick gold\">Tira-dúvidas</span>Perguntas frequentes</h2>\n<div class=\"mj-faq\">\n<details open>\n<summary>Pode beber álcool tomando Mounjaro?</summary>\n<div class=\"a\">O ideal é evitar ou reduzir bastante. O álcool atrapalha a hidratação, pode aumentar o desconforto no estômago e prejudica o resultado. Se for beber, faça com muita moderação e converse com o seu médico.</div>\n</details>\n<details>\n<summary>Quantas calorias devo comer tomando Mounjaro?</summary>\n<div class=\"a\">Depende do seu gasto calórico, que muda conforme peso, altura, idade e treino. Use a <a href=\"https://fabriciomoura.com/calculadora-de-imc-e-calorias\" target=\"_blank\" rel=\"noopener\">calculadora de gasto calórico</a> do site como ponto de partida. O número ideal para emagrecer sem perder músculo é definido no acompanhamento individual.</div>\n</details>\n<details>\n<summary>Vou perder músculo tomando Mounjaro?</summary>\n<div class=\"a\">Pode acontecer se você comer pouca proteína e não treinar força. Com proteína adequada e treino de força, você preserva (ou até ganha) músculo enquanto perde gordura.</div>\n</details>\n<details>\n<summary>Preciso de acompanhamento mesmo usando a medicação?</summary>\n<div class=\"a\">Sim. A medicação reduz o apetite, mas não ensina o que comer. O acompanhamento garante que você perca gordura com saúde, mantenha o músculo e sustente o resultado a longo prazo.</div>\n</details>\n<details>\n<summary>O que comer no café da manhã tomando Mounjaro?</summary>\n<div class=\"a\">Comece pela proteína: ovos, iogurte natural ou queijo magro, com uma fatia de pão integral e uma fruta. Café sem açúcar. A ideia é um café da manhã que segura a fome sem pesar no estômago.</div>\n</details>\n<details>\n<summary>Quem toma Mounjaro pode comer arroz?</summary>\n<div class=\"a\">Pode. Nenhum carboidrato é proibido. O arroz entra em porção moderada, sempre depois da proteína e dos vegetais. O que sabota o resultado é o excesso, não o arroz em si.</div>\n</details>\n<details>\n<summary>Preciso fazer dieta ou o Mounjaro emagrece sozinho?</summary>\n<div class=\"a\">O Mounjaro reduz o apetite, mas quem define se você perde gordura ou músculo é a alimentação. Sem uma dieta com proteína adequada, é comum perder massa magra e recuperar o peso ao parar a medicação. A dieta é o que faz o resultado durar.</div>\n</details></div>\n<div class=\"mj-proof\">\n<h2><span class=\"kick gold\">Prova real</span>Transformações de quem fez o acompanhamento</h2>\n<div class=\"mj-proof-grid\">\n          <img decoding=\"async\" src=\"https://fabriciomoura.com/wp-content/uploads/2024/10/1-1.png\" alt=\"Transformação de aluno do Fabricio Moura\" loading=\"lazy\" /><br />\n          <img decoding=\"async\" src=\"https://fabriciomoura.com/wp-content/uploads/2024/10/2-1.png\" alt=\"Transformação de aluno do Fabricio Moura\" loading=\"lazy\" /><br />\n          <img decoding=\"async\" src=\"https://fabriciomoura.com/wp-content/uploads/2024/10/3-1.png\" alt=\"Transformação de aluno do Fabricio Moura\" loading=\"lazy\" />\n        </div>\n<p class=\"mj-proof-cap\">Mais de 2.000 transformações reais em 7 países.</p>\n</p></div>\n<div class=\"mj-cta\">\n<div class=\"mj-cta-text\">\n<h2>Quer um cardápio feito pra você?</h2>\n<p>Eu monto a sua estratégia de nutrição e treino para você aproveitar o Mounjaro ao máximo, perdendo gordura, mantendo músculo e com acompanhamento de perto. Tudo com garantia.</p>\n<p>        <a class=\"mj-btn\" href=\"https://wa.me/+5511914849797?text=Oi%20Fabricio!%20Li%20o%20artigo%20sobre%20card%C3%A1pio%20no%20Mounjaro%20e%20quero%20um%20acompanhamento%20individual.\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\"><path d=\"M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.866 9.866 0 001.51 5.26l-.999 3.648 3.978-1.607z\"/></svg>Falar com o Fabricio</a>\n        </div>\n<p>        <img decoding=\"async\" class=\"mj-cta-img\" src=\"https://fabriciomoura.com/wp-content/uploads/2024/06/Design-sem-nome-15-e1781459644476.png\" alt=\"Fabricio Moura\" loading=\"lazy\" />\n      </div>\n<p class=\"mj-disc\">Aviso: o Mounjaro (tirzepatida) é um medicamento de prescrição médica. Este conteúdo é educativo e não substitui a orientação do seu médico nem uma avaliação nutricional individual. Siga sempre as recomendações do profissional que acompanha o seu caso.</p>\n</article></div>\n</div>\n<p><script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[\n{\"@type\":\"Question\",\"name\":\"Pode beber álcool tomando Mounjaro?\",\"a